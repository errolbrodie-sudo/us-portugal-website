# Copy to .env.local for local work. Set the real values in Vercel → Project → Settings → Environment Variables.
# Never commit real values: the GitHub repository is public.

# Supabase → Connect → "Transaction pooler" (Supavisor, port 6543) connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional but recommended: Supabase → Database → Settings → SSL certificate (PEM contents).
# When set, the database server certificate is verified. Literal "\n" sequences are accepted.
DATABASE_CA_CERT=

# Random secret of at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=

# Administrator identity (not an email account).
ADMIN_USERNAME=
# Preferred: an Argon2id hash from `npm run hash-password`. ADMIN_PASSWORD is used only if no hash is set.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
